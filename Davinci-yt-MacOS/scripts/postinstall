#!/bin/bash

echo "postinstall started" > /tmp/yt_debug.log

REAL_USER=$(stat -f%Su /dev/console)
REAL_HOME=$(dscl . -read /Users/"$REAL_USER" NFSHomeDirectory | awk '{print $2}')
echo "REAL_USER=$REAL_USER" >> /tmp/yt_debug.log
echo "REAL_HOME=$REAL_HOME" >> /tmp/yt_debug.log

SCRIPTS_TARGET="$REAL_HOME/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/Scripts/Edit"

# Copy the frozen app to /Applications
rm -rf "/Applications/YTforResolve.app"
cp -R "/tmp/yt_installer_app/YTforResolve.app" "/Applications/"
echo "app cp exit code: $?" >> /tmp/yt_debug.log
chown -R "$REAL_USER" "/Applications/YTforResolve.app"

# Copy the stub script into Resolve's Scripts/Edit folder
mkdir -p "$SCRIPTS_TARGET"
cp "/tmp/yt_installer_script/yt-downloader-stub.py" "$SCRIPTS_TARGET/"
echo "stub cp exit code: $?" >> /tmp/yt_debug.log
chown "$REAL_USER" "$SCRIPTS_TARGET/yt-downloader-stub.py"

echo "postinstall finished" >> /tmp/yt_debug.log
exit 0
